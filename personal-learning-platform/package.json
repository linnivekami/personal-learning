{
  "name": "personal-learning-platform",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-worker.mjs && node scripts/build-node.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "tsc --noEmit && vitest run",
    "validate": "node scripts/validate-artifact.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:generate": "node scripts/migrations.mjs",
    "skill:sync": "node scripts/sync-skill.mjs",
    "migrate:legacy": "node scripts/import-legacy.mjs",
    "configure": "node scripts/configure.mjs",
    "deploy": "npm run build && wrangler deploy",
    "build:runner": "node scripts/build-runner.mjs",
    "start": "node --enable-source-maps dist/node/server.mjs",
    "dev:node": "npm run build && node --env-file-if-exists=.dev.vars --enable-source-maps dist/node/server.mjs",
    "deploy:fly": "fly deploy"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.50.0-build1",
    "better-auth": "^1.3.0",
    "dompurify": "^3.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.9.0",
    "katex": "^0.19.0",
    "lucide-react": "^0.468.0",
    "marked": "^16.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "@cloudflare/workers-types": "^5.20261018.1",
    "@types/katex": "^0.16.7",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^8.0.13",
    "vitest": "^5.0.5",
    "wrangler": "^4.38.0"
  }
}
